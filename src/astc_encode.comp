#version 450
/*
 * Universal BCN -> ASTC re-encoder.
 *
 * Runs AFTER any of the existing BCN decode shaders (s3tc.comp, rgtc.comp,
 * bc6.comp, bc7.comp) have written their output into a shared, linear
 * RGBA8 buffer (the same "uOutputBlock" buffer layout those shaders already
 * use in their non-image-view / buffer path). This shader does not care
 * which original BCn format (BC1..BC7) produced that data - by the time it
 * runs, everything is already plain RGBA8, so every format is re-encoded
 * to ASTC identically, with no per-format special casing.
 *
 * Fixed, always-valid ASTC 4x4 LDR block configuration used here
 * (derived directly from Khronos ASTC spec, Appendix C):
 *
 *   - Block footprint         : 4x4 texels
 *   - Partitions               : 1 (single partition, no partition search)
 *   - Dual plane                : off
 *   - Weight grid               : 4x4 (== texel grid, so NO weight infill
 *                                 interpolation is needed - 1 weight/texel)
 *   - Weight range               : R=100b, H=0  -> "0..3" (pure 2-bit binary)
 *   - Color Endpoint Mode (CEM) : 12 (LDR RGBA, Direct)
 *   - Endpoint range             : automatically resolved by any conformant
 *                                   decoder to the maximal available range
 *                                   (256 levels / 8 bits, pure binary) because
 *                                   remaining_bits (79) >= bits_needed (64)
 *                                   and 256 is the largest defined LDR range,
 *                                   so endpoints round-trip with ZERO
 *                                   quantization error.
 *
 * Fixed 11-bit block mode value = 0x050 (80 decimal). Derivation:
 *   Row "D H B A R0 0 0 R2 R1 : Width=B+4, Height=A+2" (Table C.2.8)
 *   D=0 H=0 B=00(->W=4) A=10(->H=4) R0=1 R2=0 R1=0  (R=100b => weight range 0..3)
 *   bits (10..0) = 0 0 00 10 1 0 0 0 0 = 0x050
 *
 * Block bit layout (128 bits total, word0=bits[0:31] ... word3=bits[96:127]):
 *   [0:10]   block mode        = 0x050
 *   [11:12]  partition count-1 = 0  (1 partition)
 *   [13:16]  CEM                = 12
 *   [17:80]  8 endpoint values (v0..v7), 8 bits each, packed low-to-high
 *            v0=R0 v1=R1 v2=G0 v3=G1 v4=B0 v5=B1 v6=A0 v7=A1
 *            (decoded per spec "Mode 12 LDR RGBA direct", provided
 *             s1=v1+v3+v5 >= s0=v0+v2+v4 so the plain, non-blue-contracted
 *             path is taken - this shader guarantees that by construction)
 *   [81:95]  unused padding (left as 0)
 *   [96:127] 16 weights x 2 bits, stored bit-reversed from the top of the
 *            block (per spec C.2.16: "stream grows downward from the MSB").
 *
 * NOTE: This is a compact, always-conformant single-partition encoder -
 * it intentionally skips partition search, base+offset/base+scale CEMs,
 * and dual-plane mode for simplicity and guaranteed-valid bit packing.
 * That means quality is roughly comparable to a simple BC1/BC7-style
 * bounding-box encoder (good for smooth gradients, weaker on blocks that
 * truly need 2-3 partitions). Validate the produced .astc data against a
 * reference decoder (e.g. ARM astc-encoder's astcenc -d, or a real ASTC-
 * capable GPU + validation layers) before shipping, since this could not
 * be executed/tested in this environment.
 */

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) writeonly buffer uAstcOutputBlock {
	uint data[];
} uAstcOutput;

// Shared RGBA8 buffer written by the existing BCN decode shaders
// (s3tc.comp / rgtc.comp / bc6.comp / bc7.comp, buffer-output path).
layout(set = 0, binding = 1) readonly buffer uDecodedInputBlock {
	uint data[];
} uDecoded;

layout(push_constant) uniform Registers
{
	int format;          // unused here, kept for struct compatibility
	int width;
	int height;
	int offset;           // unused
	int bufferRowLength;   // unused - decoded buffer is assumed tightly packed
	int offsetX;            // unused
	int offsetY;             // unused
} registers;

// ---- Bit insertion helper (writes `bits` low bits of `value` starting at
//      absolute bit `offset` within the 128-bit block). Mirrors the
//      extract_bits() helper used by the decode shaders, but for writing. ----
void insert_bits(inout uvec4 payload, int offset, int bits, uint value)
{
	if (bits <= 0)
		return;

	uint vmask = (bits >= 32) ? 0xFFFFFFFFu : ((1u << bits) - 1u);
	value &= vmask;

	int word = offset >> 5;
	int bit = offset & 31;
	int last_offset = offset + bits - 1;

	if ((last_offset >> 5) == word)
	{
		uint mask = vmask << bit;
		payload[word] = (payload[word] & ~mask) | (value << bit);
	}
	else
	{
		int first_bits = 32 - bit;
		uint mask0 = 0xFFFFFFFFu << bit;
		payload[word] = (payload[word] & ~mask0) | ((value << bit) & mask0);

		uint value2 = value >> first_bits;
		int bits2 = bits - first_bits;
		uint mask1 = (bits2 >= 32) ? 0xFFFFFFFFu : ((1u << bits2) - 1u);
		payload[word + 1] = (payload[word + 1] & ~mask1) | (value2 & mask1);
	}
}

const uint BLOCK_MODE = 0x050u; // 4x4 weight grid, range 0..3, single plane
const uint CEM_RGBA_DIRECT = 12u;

void main()
{
	int width = registers.width;
	int height = registers.height;

	ivec2 blockCoord = ivec2(gl_GlobalInvocationID.xy);
	int blocksPerRow = (width + 3) / 4;
	int blocksPerCol = (height + 3) / 4;

	if (blockCoord.x >= blocksPerRow || blockCoord.y >= blocksPerCol)
		return;

	// --- Gather (and edge-clamp) the 16 source texels for this block ---
	vec4 texel[16];
	for (int ty = 0; ty < 4; ty++)
	{
		for (int tx = 0; tx < 4; tx++)
		{
			ivec2 px = min(blockCoord * 4 + ivec2(tx, ty), ivec2(width - 1, height - 1));
			int idx = px.y * width + px.x;
			uint packed = uDecoded.data[idx];
			texel[ty * 4 + tx] = unpackUnorm4x8(packed);
		}
	}

	// --- Bounding-box endpoints (min/max per channel), BC1/BC7-style ---
	vec4 colMin = texel[0];
	vec4 colMax = texel[0];
	for (int i = 1; i < 16; i++)
	{
		colMin = min(colMin, texel[i]);
		colMax = max(colMax, texel[i]);
	}

	uvec4 A8 = uvec4(round(colMin * 255.0));
	uvec4 B8 = uvec4(round(colMax * 255.0));

	// v0=R0 v1=R1 v2=G0 v3=G1 v4=B0 v5=B1 v6=A0 v7=A1, with e0<-A, e1<-B.
	// Per spec Mode 12: only decodes back to (A,B) directly (no blue
	// contraction) when s1=(v1+v3+v5) >= s0=(v0+v2+v4). Enforce this by
	// construction: if it doesn't hold, swap which corner is "A" vs "B"
	// (and correspondingly flip the interpolation direction of weights).
	bool swapped = false;
	{
		uint s0 = A8.r + A8.g + A8.b;
		uint s1 = B8.r + B8.g + B8.b;
		if (s1 < s0)
		{
			uvec4 tmp = A8; A8 = B8; B8 = tmp;
			swapped = true;
		}
	}

	uint v0 = A8.r, v1 = B8.r;
	uint v2 = A8.g, v3 = B8.g;
	uint v4 = A8.b, v5 = B8.b;
	uint v6 = A8.a, v7 = B8.a;

	// --- Per-texel weights (2-bit, values 0..3) via projection onto the
	//     A->B line in RGBA space. Effective unquantized interpolation
	//     amounts for values {0,1,2,3} are {0,21,43,64}/64 (bit-replication
	//     of a 2-bit value per spec C.2.17), which is close enough to the
	//     ideal {0, 1/3, 2/3, 1} that a simple round-to-nearest-of-4 works. ---
	vec4 colA = vec4(A8) / 255.0;
	vec4 colB = vec4(B8) / 255.0;
	vec4 dir = colB - colA;
	float denom = dot(dir, dir);

	uint stream_value = 0u;
	for (int i = 0; i < 16; i++)
	{
		float t = 0.0;
		if (denom > 0.0)
		{
			t = dot(texel[i] - colA, dir) / denom;
			t = clamp(t, 0.0, 1.0);
		}
		if (swapped)
			t = 1.0 - t;

		uint q = uint(clamp(round(t * 3.0), 0.0, 3.0));
		stream_value |= (q & 3u) << (2 * i);
	}

	// --- Assemble the 128-bit block ---
	uvec4 payload = uvec4(0u);

	insert_bits(payload, 0, 11, BLOCK_MODE);
	insert_bits(payload, 11, 2, 0u);              // 1 partition
	insert_bits(payload, 13, 4, CEM_RGBA_DIRECT);

	insert_bits(payload, 17, 8, v0);
	insert_bits(payload, 25, 8, v1);
	insert_bits(payload, 33, 8, v2);
	insert_bits(payload, 41, 8, v3);
	insert_bits(payload, 49, 8, v4);
	insert_bits(payload, 57, 8, v5);
	insert_bits(payload, 65, 8, v6);
	insert_bits(payload, 73, 8, v7);

	// Weight stream occupies the top word, growing down from bit 127,
	// which is equivalent to bit-reversing the naturally-packed 32-bit
	// weight stream and storing it directly in word[3].
	payload.w = bitfieldReverse(stream_value);

	int blockIndex = blockCoord.y * blocksPerRow + blockCoord.x;
	int outOffset = blockIndex * 4;
	uAstcOutput.data[outOffset + 0] = payload.x;
	uAstcOutput.data[outOffset + 1] = payload.y;
	uAstcOutput.data[outOffset + 2] = payload.z;
	uAstcOutput.data[outOffset + 3] = payload.w;
}
